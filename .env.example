# 설정 예시. 실제 값은 .env.local 에 넣는다 (.env.local 은 git 에 올리지 않음)
# 값 위치: Supabase 대시보드 → Project Settings → API Keys / Data API

# 프로젝트 URL (예: https://abcdefgh.supabase.co)
SUPABASE_URL=

# anon 키 (또는 sb_publishable_ 로 시작하는 publishable 키) — 조회에 사용
SUPABASE_ANON_KEY=

# service_role 키 (또는 sb_secret_ 로 시작하는 secret 키) — 추가 · 삭제에 사용
SUPABASE_SERVICE_ROLE_KEY=

# 추가 · 삭제 비밀번호 (선택). 넣으면 화면에서 추가 · 삭제할 때 묻는다. Vercel 배포에서는 꼭 넣는다
ADMIN_PASSWORD=

# 페이지 포트 (기본 3000)
PORT=3000
